# Milvus Configuration
# URI: Your Milvus cloud instance URI (e.g., https://your-instance.milvus.cloud)
MILVUS_URI=
# TOKEN: Your Milvus API token
MILVUS_TOKEN=

# Supabase Configuration
# URL: Your Supabase project URL
SUPABASE_URL=
# ANON_KEY: Your Supabase anonymous public key
SUPABASE_ANON_KEY=

# API Keys
# Groq API key for LLM interactions
GROQ_API_KEY=


# Optional GPU Configuration
# Set to 'true' to force CPU usage instead of GPU
FORCE_CPU=false
# GPU memory fraction to use (0.0-1.0)
GPU_MEMORY_FRACTION=0.8
# Use mixed precision for faster inference
USE_MIXED_PRECISION=true
